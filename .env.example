# ------------------------------------------------ storage & infrastructure
# NOT source keys. These are what a restore needs FIRST: without the Hippius
# block nothing is mirrored off the box, and the scraped tree becomes the only
# copy of the data. See docs/RUNBOOK.md.

# Hippius S3 mirror — scrape_all.sh pushes data/ + sources.yaml here every
# 15 min, and sync_storage.py --pull restores from it. Append-only.
HIPPIUS_S3_ACCESS_KEY=
HIPPIUS_S3_SECRET_KEY=
# Optional overrides (defaults shown in src/sources/sync_storage.py)
# HIPPIUS_S3_BUCKET=tsbench-forge-sources
# HIPPIUS_S3_ENDPOINT=
# HIPPIUS_S3_REGION=decentralized

# Eval-pool publish target. Belongs to the cascade side, which pulls FROM the
# Hippius bucket; listed here only so a restore knows the name exists.
TSFORGE_S3_ACCESS_KEY=
TSFORGE_S3_SECRET_KEY=
CASCADE_S3_ACCESS_KEY=
CASCADE_S3_SECRET_KEY=

# Model / compute accounts used by the comparison harness, not by scraping.
HF_TOKEN=
LIUM_API_KEY=
TABPFN_TOKEN=

# ------------------------------------------- per-source keys added since v1
