EMONCMS_API_KEY=
# ESA space-weather service — https://swe.ssa.esa.int/
ESA_SWE_TOKEN=
# NVD CVE feed; without a key the rate limit is severe
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Metaculus forecast series — https://www.metaculus.com/accounts/signup/
METACULUS_API_TOKEN=
# eBay Browse API — OAuth token, expires and must be refreshed
# https://developer.ebay.com/
EBAY_OAUTH_TOKEN=
